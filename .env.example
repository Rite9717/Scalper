# Copy to .env. Paper mode starts with these values.
# Live mode also needs SCALPER_TRADING_MODE=live, a public static IP,
# your Zerodha user id, both Kite credentials, and the exact confirmation
# phrase printed by: python -m scalper health

SCALPER_TRADING_MODE=paper
SCALPER_LOG_LEVEL=INFO
SCALPER_LOG_JSON=true
SCALPER_EXPECTED_USER_ID=
SCALPER_KITE_API_KEY=
SCALPER_KITE_API_SECRET=
SCALPER_STATIC_IP=
SCALPER_DATABASE_URL=postgresql://scalper:scalper@localhost:5432/scalper
SCALPER_REDIS_URL=redis://localhost:6379/0
SCALPER_DATA_DIR=data
SCALPER_SESSION_PATH=data/session.json
SCALPER_INSTRUMENT_ARCHIVE_DIR=data/instruments

SCALPER_CALLBACK_HOST=127.0.0.1
SCALPER_CALLBACK_PORT=8765
SCALPER_LOGIN_TIMEOUT_SECONDS=300

# Futures charges checked 27 Oct 2026. Update these when the tariff changes.
# SCALPER_COST_MULTIPLE=2
# SCALPER_STT_SELL_RATE=0.0005
# SCALPER_EXCHANGE_RATE=0.0000183
# SCALPER_STAMP_BUY_RATE=0.00002
# SCALPER_FLATTEN_TIME=15:20
# SCALPER_ALERTS_ENABLED=false
# SCALPER_TELEGRAM_BOT_TOKEN=
# SCALPER_TELEGRAM_CHAT_ID=

# Request tokens are one-time. `scalper login` catches one in the browser.
# `scalper session exchange` is the manual fallback. Do not commit a token.
# SCALPER_REQUEST_TOKEN=
